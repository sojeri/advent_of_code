{
    "dependencies": {
        "lodash": "^4.18.1"
    },
    "devDependencies": {
        "husky": "^9.0.0",
        "mocha": "^12.0.0",
        "notes": "0.0.4",
        "prettier": "^3.0.0",
        "pretty-quick": "^4.0.0",
        "sinon": "^21.0.0"
    },
    "scripts": {
        "fixNew": "chmod -x ./utils/js/createScaffold.js",
        "new": "./utils/js/createScaffold.js",
        "notes": "notes",
        "prepare": "husky",
        "pretty": "prettier --write '{**/20**,project_euler,sandbox,utils}/{,**/}*.js'",
        "test": "mocha '**/*test.js' --reporter nyan --ignore 'node_modules/**' --ignore '**/templates/**'",
        "test:verbose": "mocha '**/*test.js' --ignore 'node_modules/**' --ignore '**/templates/**'",
        "tv": "npm run --silent test:verbose",
        "watdo": "echo '\n\n\nforgot how to use me between years? :)\n\n\n'; npm run new",
        "f1": "npm run --silent watdo",
        "halp": "npm run --silent watdo",
        "help": "npm run --silent watdo",
        "how": "npm run --silent watdo",
        "wat": "npm run --silent watdo",
        "what": "npm run --silent watdo"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sojeri/advent_of_code.git"
    },
    "author": "Jeri Sommers 🐍 <some.jeriATgmail.com>",
    "license": "MIT"
}
