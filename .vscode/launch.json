{
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Mocha Tests",
            "program": "${workspaceFolder}/node_modules/mocha/bin/_mocha",
            "args": [
                "-u",
                "tdd",
                "--timeout",
                "999999",
                "--colors",
                "**/*test.js",
                "--ignore",
                "node_modules/**",
                "--ignore",
                "**/templates/**"
            ],
            "internalConsoleOptions": "openOnSessionStart"
        }
    ]
}
